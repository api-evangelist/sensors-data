          {
            "name": "query",
            "value": "张三",
            "type": "query",
            "description": "模糊搜索关键字，模糊匹配账号的 username 或 cname"
          },
          {
            "name": "expand_field",
            "value": "last_access_time",
            "type": "query",
            "description": "扩展字段，多个字段使用英文逗号分隔，例如：last_access_time,xxx"
          }
